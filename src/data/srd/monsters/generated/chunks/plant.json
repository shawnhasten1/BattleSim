 "definitions": [
  {"id":"srd:monster:awakened-shrub","name":"Awakened Shrub","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"awakened-shrub","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"small","type":"plant","armorClass":9,"maxHp":10,"speed":20,"movement":{"walk":20},"proficiencyBonus":2,"challengeRating":0,"alignment":"unaligned","environments":["Forest or Jungle","Laboratory","Swamp or Marsh"],"skills":{},"languages":"one language known by its creator","abilities":{"str":3,"dex":8,"con":11,"int":10,"wis":10,"cha":6},"damageAdjustments":[{"type":"resistance","damageType":"piercing"},{"type":"vulnerability","damageType":"fire"}],"traits":[{"id":"awakened-shrub-trait-false-appearance","name":"False Appearance","category":"trait","description":"While the shrub remains motionless, it is indistinguishable from a normal shrub.","automationSupport":"manual-only"}],"actions":[{"kind":"attack","id":"rake","name":"Rake","actionType":"action","attackType":"melee","ability":"dex","attackBonus":1,"range":5,"reach":5,"damage":[{"dice":"1d4","damageType":"slashing","abilityModifier":"dex"}],"automationSupport":"full"}]},
  {"id":"srd:monster:awakened-tree","name":"Awakened Tree","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"awakened-tree","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"plant","armorClass":13,"maxHp":59,"speed":20,"movement":{"walk":20},"proficiencyBonus":2,"challengeRating":2,"alignment":"unaligned","environments":["Forest or Jungle","Swamp or Marsh"],"skills":{},"languages":"one language known by its creator","abilities":{"str":19,"dex":6,"con":15,"int":10,"wis":10,"cha":7},"damageAdjustments":[{"type":"resistance","damageType":"bludgeoning"},{"type":"resistance","damageType":"piercing"},{"type":"vulnerability","damageType":"fire"}],"traits":[{"id":"awakened-tree-trait-false-appearance","name":"False Appearance","category":"trait","description":"While the tree remains motionless, it is indistinguishable from a normal tree.","automationSupport":"manual-only"}],"actions":[{"kind":"attack","id":"slam","name":"Slam","actionType":"action","attackType":"melee","ability":"str","attackBonus":6,"range":10,"reach":10,"damage":[{"dice":"3d6","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"}]},
  {"id":"srd:monster:shambling-mound","name":"Shambling Mound","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"shambling-mound","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"large","type":"plant","armorClass":15,"maxHp":136,"speed":20,"movement":{"walk":20,"swim":20},"proficiencyBonus":3,"challengeRating":5,"alignment":"unaligned","environments":["Forest or Jungle","Feywild","Swamp or Marsh"],"senses":{"blindsight":60},"skills":{"stealth":2},"abilities":{"str":18,"dex":8,"con":16,"int":5,"wis":10,"cha":5},"damageAdjustments":[{"type":"resistance","damageType":"cold"},{"type":"resistance","damageType":"fire"},{"type":"immunity","damageType":"lightning"}],"conditionImmunities":["blinded","deafened","exhaustion"],"traits":[{"id":"shambling-mound-trait-lightning-absorption","name":"Lightning Absorption","category":"trait","description":"Whenever the shambling mound is subjected to lightning damage, it takes no damage and regains a number of hit points equal to the lightning damage dealt.","automationSupport":"manual-only"},{"id":"shambling-mound-trait-condition-immunities","name":"Condition Immunities: Blinded, Deafened, Exhaustion","category":"trait","description":"Immune to: blinded, deafened, exhaustion.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"slam","count":2}],"automationSupport":"full"},{"kind":"attack","id":"slam","name":"Slam","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"2d8","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"unsupported","id":"engulf","name":"Engulf","description":"The shambling mound engulfs a Medium or smaller creature grappled by it. The engulfed target is blinded, restrained, and unable to breathe, and it must succeed on a DC 14 Constitution saving throw at the start of each of the mound's turns or take 13 (2d8 + 4) bludgeoning damage. If the mound moves, the engulfed target moves with it. The mound can have only one creature engulfed at a time.","actionType":"action","automationSupport":"unsupported"}]},
  {"id":"srd:monster:shrieker","name":"Shrieker","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"shrieker","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"medium","type":"plant","armorClass":5,"maxHp":13,"speed":0,"movement":{"walk":0},"proficiencyBonus":2,"challengeRating":0,"alignment":"unaligned","environments":["Caves","Forest or Jungle","Swamp or Marsh","Underworld"],"senses":{"blindsight":30},"skills":{},"abilities":{"str":1,"dex":1,"con":10,"int":1,"wis":3,"cha":1},"conditionImmunities":["blinded","deafened","frightened"],"traits":[{"id":"shrieker-trait-false-appearance","name":"False Appearance","category":"trait","description":"While the shrieker remains motionless, it is indistinguishable from an ordinary fungus.","automationSupport":"manual-only"},{"id":"shrieker-trait-condition-immunities","name":"Condition Immunities: Blinded, Deafened, Frightened","category":"trait","description":"Immune to: blinded, deafened, frightened.","automationSupport":"manual-only"}],"actions":[{"kind":"unsupported","id":"shriek","name":"Shriek","description":"When bright light or a creature is within 30 feet of the shrieker, it emits a shriek audible within 300 feet of it. The shrieker continues to shriek until the disturbance moves out of range and for 1d4 of the shrieker's turns afterward","actionType":"action","automationSupport":"unsupported"}]},
  {"id":"srd:monster:treant","name":"Treant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"treant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"plant","armorClass":16,"maxHp":138,"speed":30,"movement":{"walk":30},"proficiencyBonus":4,"challengeRating":9,"alignment":"chaotic good","environments":["Forest or Jungle","Swamp or Marsh"],"skills":{},"languages":"Common, Druidic, Elvish, Sylvan","abilities":{"str":23,"dex":8,"con":21,"int":12,"wis":16,"cha":12},"damageAdjustments":[{"type":"resistance","damageType":"bludgeoning"},{"type":"resistance","damageType":"piercing"},{"type":"vulnerability","damageType":"fire"}],"traits":[{"id":"treant-trait-false-appearance","name":"False Appearance","category":"trait","description":"While the treant remains motionless, it is indistinguishable from a normal tree.","automationSupport":"manual-only"},{"id":"treant-trait-siege-monster","name":"Siege Monster","category":"trait","description":"The treant deals double damage to objects and structures.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"slam","count":2}],"automationSupport":"full"},{"kind":"attack","id":"slam","name":"Slam","actionType":"action","attackType":"melee","ability":"str","attackBonus":10,"range":5,"reach":5,"damage":[{"dice":"3d6","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":10,"range":60,"longRange":180,"damage":[{"dice":"4d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"unsupported","id":"animate-trees","name":"Animate Trees","description":"The treant magically animates one or two trees it can see within 60 feet of it. These trees have the same statistics as a treant, except they have Intelligence and Charisma scores of 1, they can't speak, and they have only the Slam action option. An animated tree acts as an ally of the treant. The tree remains animate for 1 day or until it dies; until the treant dies or is more than 120 feet from the tree; or until the treant takes a bonus action to turn it back into an inanimate tree. The tree then takes root if possible.","actionType":"action","automationSupport":"unsupported"}]},
  {"id":"srd:monster:violet-fungus","name":"Violet Fungus","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"violet-fungus","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"medium","type":"plant","armorClass":5,"maxHp":18,"speed":5,"movement":{"walk":5},"proficiencyBonus":2,"challengeRating":0.25,"alignment":"unaligned","environments":["Caves","Forest or Jungle","Swamp or Marsh","Underworld"],"senses":{"blindsight":30},"skills":{},"abilities":{"str":3,"dex":1,"con":10,"int":1,"wis":3,"cha":1},"conditionImmunities":["blinded","deafened","frightened"],"traits":[{"id":"violet-fungus-trait-false-appearance","name":"False Appearance","category":"trait","description":"While the violet fungus remains motionless, it is indistinguishable from an ordinary fungus.","automationSupport":"manual-only"},{"id":"violet-fungus-trait-condition-immunities","name":"Condition Immunities: Blinded, Deafened, Frightened","category":"trait","description":"Immune to: blinded, deafened, frightened.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"rotting-touch","count":3}],"automationSupport":"full"},{"kind":"attack","id":"rotting-touch","name":"Rotting Touch","actionType":"action","attackType":"melee","ability":"con","attackBonus":2,"range":10,"reach":10,"damage":[{"dice":"1d8","damageType":"necrotic","abilityModifier":"con"}],"automationSupport":"full"}]}
