 "definitions": [
  {"id":"srd:monster:cloud-giant","name":"Cloud Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"cloud-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":14,"maxHp":200,"speed":40,"movement":{"walk":40},"proficiencyBonus":4,"challengeRating":9,"alignment":"neutral good (50%) or neutral evil (50%)","environments":["Mountain","Plane of Air"],"skills":{"insight":7,"perception":7},"languages":"Common, Giant","abilities":{"str":27,"dex":10,"con":22,"int":12,"wis":16,"cha":16},"saves":{"con":10,"wis":7,"cha":7},"traits":[{"id":"cloud-giant-trait-innate-spellcasting","name":"Innate Spellcasting","category":"trait","description":"The giant's innate spellcasting ability is Charisma. It can innately cast the following spells, requiring no material components:\n\nAt will: detect magic, fog cloud, light\n3/day each: feather fall, fly, misty step, telekinesis\n1/day each: control weather, gaseous form","automationSupport":"manual-only"},{"id":"cloud-giant-trait-keen-smell","name":"Keen Smell","category":"trait","description":"The giant has advantage on Wisdom (Perception) checks that rely on smell.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"morningstar","count":2}],"automationSupport":"full"},{"kind":"attack","id":"morningstar","name":"Morningstar","actionType":"action","attackType":"melee","ability":"str","attackBonus":12,"range":10,"reach":10,"damage":[{"dice":"3d8","damageType":"piercing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":12,"range":60,"longRange":240,"damage":[{"dice":"4d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"basic-ranged"},
  {"id":"srd:monster:ettin","name":"Ettin","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"ettin","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"large","type":"giant","armorClass":12,"maxHp":85,"speed":40,"movement":{"walk":40},"proficiencyBonus":2,"challengeRating":4,"alignment":"chaotic evil","environments":["Hills","Mountain","Ruins","Underworld"],"senses":{"darkvision":60},"skills":{"perception":4},"languages":"Giant, Orc","abilities":{"str":21,"dex":8,"con":17,"int":6,"wis":10,"cha":8},"traits":[{"id":"ettin-trait-two-heads","name":"Two Heads","category":"trait","description":"The ettin has advantage on Wisdom (Perception) checks and on saving throws against being blinded, charmed, deafened, frightened, stunned, and knocked unconscious.","automationSupport":"full","effects":[{"kind":"save-advantage","against":{"conditions":["blinded","charmed","deafened","frightened","stunned","unconscious"]}}]},{"id":"ettin-trait-wakeful","name":"Wakeful","category":"trait","description":"When one of the ettin's heads is asleep, its other head is awake.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"battleaxe","count":1},{"actionId":"morningstar","count":1}],"automationSupport":"full"},{"kind":"attack","id":"battleaxe","name":"Battleaxe","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"2d8","damageType":"slashing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"morningstar","name":"Morningstar","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"2d8","damageType":"piercing","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"brute"},
  {"id":"srd:monster:fire-giant","name":"Fire Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"fire-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":18,"maxHp":162,"speed":30,"movement":{"walk":30},"proficiencyBonus":4,"challengeRating":9,"alignment":"lawful evil","environments":["Desert","Mountain","Plane of Fire","Underworld","Urban"],"skills":{"athletics":11,"perception":6},"languages":"Giant","abilities":{"str":25,"dex":9,"con":23,"int":10,"wis":14,"cha":13},"saves":{"dex":3,"con":10,"cha":5},"damageAdjustments":[{"type":"immunity","damageType":"fire"}],"traits":[],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"greatsword","count":2}],"automationSupport":"full"},{"kind":"attack","id":"greatsword","name":"Greatsword","actionType":"action","attackType":"melee","ability":"str","attackBonus":11,"range":10,"reach":10,"damage":[{"dice":"6d6","damageType":"slashing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":11,"range":60,"longRange":240,"damage":[{"dice":"4d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"brute"},
  {"id":"srd:monster:frost-giant","name":"Frost Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"frost-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":15,"maxHp":138,"speed":40,"movement":{"walk":40},"proficiencyBonus":3,"challengeRating":8,"alignment":"neutral evil","environments":["Arctic or Tundra","Mountain","Shadowfell"],"skills":{"athletics":9,"perception":3},"languages":"Giant","abilities":{"str":23,"dex":9,"con":21,"int":9,"wis":10,"cha":12},"saves":{"con":8,"wis":3,"cha":4},"damageAdjustments":[{"type":"immunity","damageType":"cold"}],"traits":[],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"greataxe","count":2}],"automationSupport":"full"},{"kind":"attack","id":"greataxe","name":"Greataxe","actionType":"action","attackType":"melee","ability":"str","attackBonus":9,"range":10,"reach":10,"damage":[{"dice":"3d12","damageType":"slashing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":9,"range":60,"longRange":240,"damage":[{"dice":"4d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"brute"},
  {"id":"srd:monster:hill-giant","name":"Hill Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"hill-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":13,"maxHp":105,"speed":40,"movement":{"walk":40},"proficiencyBonus":3,"challengeRating":5,"alignment":"chaotic evil","environments":["Forest or Jungle","Hills","Mountain","Ruins","Feywild","Plane of Earth"],"skills":{"perception":2},"languages":"Giant","abilities":{"str":21,"dex":8,"con":19,"int":5,"wis":9,"cha":6},"traits":[],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"greatclub","count":2}],"automationSupport":"full"},{"kind":"attack","id":"greatclub","name":"Greatclub","actionType":"action","attackType":"melee","ability":"str","attackBonus":8,"range":10,"reach":10,"damage":[{"dice":"3d8","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":8,"range":60,"longRange":240,"damage":[{"dice":"3d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"basic-ranged"},
  {"id":"srd:monster:ogre","name":"Ogre","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"ogre","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"large","type":"giant","armorClass":11,"maxHp":59,"speed":40,"movement":{"walk":40},"proficiencyBonus":2,"challengeRating":2,"alignment":"chaotic evil","environments":["Arctic or Tundra","Caves","Coast","Desert","Forest or Jungle","Grassland or Plains","Hills","Mountain","Ruins","Feywild","Plane of Earth","Swamp or Marsh","Underworld"],"senses":{"darkvision":60},"skills":{},"languages":"Common, Giant","abilities":{"str":19,"dex":8,"con":16,"int":5,"wis":7,"cha":7},"traits":[],"actions":[{"kind":"attack","id":"greatclub","name":"Greatclub","actionType":"action","attackType":"melee","ability":"str","attackBonus":6,"range":5,"reach":5,"damage":[{"dice":"2d8","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"javelin-melee","name":"Javelin (Melee)","actionType":"action","attackType":"melee","ability":"str","attackBonus":6,"range":5,"reach":5,"damage":[{"dice":"2d6","damageType":"piercing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"javelin-ranged","name":"Javelin (Ranged)","actionType":"action","attackType":"ranged","ability":"str","attackBonus":6,"range":30,"longRange":120,"damage":[{"dice":"2d6","damageType":"piercing","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"brute"},
  {"id":"srd:monster:oni","name":"Oni","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"oni","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"large","type":"giant","armorClass":16,"maxHp":110,"speed":30,"movement":{"walk":30,"fly":30},"proficiencyBonus":3,"challengeRating":7,"alignment":"lawful evil","environments":["Forest or Jungle","Urban"],"senses":{"darkvision":60},"skills":{"arcana":5,"deception":8,"perception":4},"languages":"Common, Giant","abilities":{"str":19,"dex":11,"con":16,"int":14,"wis":12,"cha":15},"saves":{"dex":3,"con":6,"wis":4,"cha":5},"traits":[{"id":"oni-trait-innate-spellcasting","name":"Innate Spellcasting","category":"trait","description":"The oni's innate spellcasting ability is Charisma (spell save DC 13). The oni can innately cast the following spells, requiring no material components:\n\nAt will: darkness, invisibility\n1/day each: charm person, cone of cold, gaseous form, sleep","automationSupport":"manual-only"},{"id":"oni-trait-magic-weapons","name":"Magic Weapons","category":"trait","description":"The oni's weapon attacks are magical.","automationSupport":"manual-only"},{"id":"oni-trait-regeneration","name":"Regeneration","category":"trait","description":"The oni regains 10 hit points at the start of its turn if it has at least 1 hit point.","automationSupport":"full","effects":[{"kind":"hp-regen","amount":10}]},{"id":"glaive-not-automated","name":"Glaive (not automated)","category":"trait","automationSupport":"manual-only","description":"or 9 (1d10 + 4) slashing damage in Small or Medium form."}],"actions":[{"kind":"multiattack","id":"multiattack-claw","name":"Multiattack (Claw)","actionType":"action","attacks":[{"actionId":"claw","count":2}],"automationSupport":"full"},{"kind":"multiattack","id":"multiattack-glaive","name":"Multiattack (Glaive)","actionType":"action","attacks":[{"actionId":"glaive","count":2}],"automationSupport":"full"},{"kind":"attack","id":"claw","name":"Claw","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"1d8","damageType":"slashing","abilityModifier":"str","magical":true}],"automationSupport":"full"},{"kind":"attack","id":"glaive","name":"Glaive","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":10,"reach":10,"damage":[{"dice":"2d10","damageType":"slashing","abilityModifier":"str","magical":true}],"automationSupport":"full"},{"kind":"unsupported","id":"change-shape","name":"Change Shape","description":"The oni magically polymorphs into a Small or Medium humanoid, into a Large giant, or back into its true form. Other than its size, its statistics are the same in each form. The only equipment that is transformed is its glaive, which shrinks so that it can be wielded in humanoid form. If the oni dies, it reverts to its true form, and its glaive reverts to its normal size.","actionType":"action","automationSupport":"unsupported"}],"defaultTactics":"brute"},
  {"id":"srd:monster:stone-giant","name":"Stone Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"stone-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":17,"maxHp":126,"speed":40,"movement":{"walk":40},"proficiencyBonus":3,"challengeRating":7,"alignment":"neutral","environments":["Hills","Mountain","Plane of Earth","Underworld"],"senses":{"darkvision":60},"skills":{"athletics":12,"perception":4},"languages":"Giant","abilities":{"str":23,"dex":15,"con":20,"int":10,"wis":12,"cha":9},"saves":{"dex":5,"con":8,"wis":4},"traits":[{"id":"stone-giant-trait-stone-camouflage","name":"Stone Camouflage","category":"trait","description":"The giant has advantage on Dexterity (Stealth) checks made to hide in rocky terrain.","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"greatclub","count":2}],"automationSupport":"full"},{"kind":"attack","id":"greatclub","name":"Greatclub","actionType":"action","attackType":"melee","ability":"str","attackBonus":9,"range":15,"reach":15,"damage":[{"dice":"3d8","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":9,"range":60,"longRange":240,"damage":[{"dice":"4d10","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full","riders":[{"kind":"condition","when":"on-hit","condition":"prone","duration":{"kind":"until-start-of-next-turn"},"save":{"ability":"str","dc":17,"onSuccess":"negates"}}]}],"reactions":[{"kind":"unsupported","id":"rock-catching","name":"Rock Catching","description":"If a rock or similar object is hurled at the giant, the giant can, with a successful DC 10 Dexterity saving throw, catch the missile and take no bludgeoning damage from it.","actionType":"reaction","automationSupport":"unsupported"}],"defaultTactics":"basic-ranged"},
  {"id":"srd:monster:storm-giant","name":"Storm Giant","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"storm-giant","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"huge","type":"giant","armorClass":16,"maxHp":230,"speed":50,"movement":{"walk":50,"swim":50},"proficiencyBonus":5,"challengeRating":13,"alignment":"chaotic good","environments":["Coast","Desert","Mountain","Ocean","Plane of Air","Plane of Water"],"skills":{"arcana":8,"athletics":14,"history":8,"perception":9},"languages":"Common, Giant","abilities":{"str":29,"dex":14,"con":20,"int":16,"wis":18,"cha":18},"saves":{"str":14,"con":10,"wis":9,"cha":9},"damageAdjustments":[{"type":"resistance","damageType":"cold"},{"type":"immunity","damageType":"lightning"},{"type":"immunity","damageType":"thunder"}],"traits":[{"id":"storm-giant-trait-amphibious","name":"Amphibious","category":"trait","description":"The giant can breathe air and water.","automationSupport":"manual-only"},{"id":"storm-giant-trait-innate-spellcasting","name":"Innate Spellcasting","category":"trait","description":"The giant's innate spellcasting ability is Charisma (spell save DC 17). It can innately cast the following spells, requiring no material components:\n\nAt will: detect magic, feather fall, levitate, light\n3/day each: control weather, water breathing","automationSupport":"manual-only"}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"greatsword","count":2}],"automationSupport":"full"},{"kind":"attack","id":"greatsword","name":"Greatsword","actionType":"action","attackType":"melee","ability":"str","attackBonus":14,"range":10,"reach":10,"damage":[{"dice":"6d6","damageType":"slashing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"rock","name":"Rock","actionType":"action","attackType":"ranged","ability":"str","attackBonus":14,"range":60,"longRange":240,"damage":[{"dice":"4d12","damageType":"bludgeoning","abilityModifier":"str"}],"automationSupport":"full"},{"id":"lightning-strike","name":"Lightning Strike","actionType":"action","saveAbility":"dex","dc":17,"damage":[{"dice":"12d8","damageType":"lightning"}],"halfDamageOnSuccess":true,"onSuccess":"half","magical":true,"automationSupport":"full","kind":"area-save","range":500,"area":{"type":"circle","size":500},"targeting":{"origin":"self","aimedFromSelf":false,"range":500},"affects":"all"}],"defaultTactics":"basic-ranged"},
  {"id":"srd:monster:troll","name":"Troll","source":{"provider":"srd","documentKey":"srd-2014","documentName":"System Reference Document 5.1","slug":"troll","url":"https://dnd.wizards.com/resources/systems-reference-document"},"size":"large","type":"giant","armorClass":15,"maxHp":84,"speed":30,"movement":{"walk":30},"proficiencyBonus":3,"challengeRating":5,"alignment":"chaotic evil","environments":["Arctic or Tundra","Caves","Forest or Jungle","Grassland or Plains","Hills","Mountain","Ruins","Feywild","Swamp or Marsh","Underworld"],"senses":{"darkvision":60},"skills":{"perception":2},"languages":"Giant","abilities":{"str":18,"dex":13,"con":20,"int":7,"wis":9,"cha":7},"traits":[{"id":"troll-trait-keen-smell","name":"Keen Smell","category":"trait","description":"The troll has advantage on Wisdom (Perception) checks that rely on smell.","automationSupport":"manual-only"},{"id":"troll-trait-regeneration","name":"Regeneration","category":"trait","description":"The troll regains 10 hit points at the start of its turn. If the troll takes acid or fire damage, this trait doesn't function at the start of the troll's next turn. The troll dies only if it starts its turn with 0 hit points and doesn't regenerate.","automationSupport":"full","effects":[{"kind":"hp-regen","amount":10,"worksAtZero":true,"suppressedByDamageTypes":["acid","fire"]}]},{"id":"troll-trait-variant-loathsome-limbs","name":"Variant: Loathsome Limbs","category":"trait","description":"Whenever the troll takes at least 15 slashing damage at one time, roll a d20 to determine what else happens to it:\n\n**1-10:** Nothing else happens.\n**11-14:** One leg is severed from the troll if it has any legs left.\n**15- 18:** One arm is severed from the troll if it has any arms left.\n**19-20:** The troll is decapitated, but the troll dies only if it can't regenerate. If it dies, so does the severed head.\n\nIf the troll finishes a short or long rest without reattaching a severed limb or head, the part regrows. At that point, the severed part dies. Until then, a severed part acts on the troll's initiative and has its own action and movement. A severed part has AC 13, 10 hit points, and the troll's Regeneration trait.\nA **severed leg** is unable to attack and has a speed of 5 feet.\nA **severed arm** has a speed of 5 feet and can make one claw attack on its turn, with disadvantage on the attack roll unless the troll can see the arm and its target. Each time the troll loses an arm, it loses a claw attack.\nIf its head is severed, the troll loses its bite attack and its body is blinded unless the head can see it. The **severed head** has a speed of 0 feet and the troll's Keen Smell trait. It can make a bite attack but only against a target in its space.\nThe troll's speed is halved if it's missing a leg. If it loses both legs, it falls prone. If it has both arms, it can crawl. With only one arm, it can still crawl, but its speed is halved. With no arms or legs, its speed is 0, and it can't benefit from bonuses to speed.","automationSupport":"manual-only","optional":true}],"actions":[{"kind":"multiattack","id":"multiattack","name":"Multiattack","actionType":"action","attacks":[{"actionId":"bite","count":1},{"actionId":"claw","count":2}],"automationSupport":"full"},{"kind":"attack","id":"bite","name":"Bite","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"1d6","damageType":"piercing","abilityModifier":"str"}],"automationSupport":"full"},{"kind":"attack","id":"claw","name":"Claw","actionType":"action","attackType":"melee","ability":"str","attackBonus":7,"range":5,"reach":5,"damage":[{"dice":"2d6","damageType":"slashing","abilityModifier":"str"}],"automationSupport":"full"}],"defaultTactics":"brute"}
 ]
}
