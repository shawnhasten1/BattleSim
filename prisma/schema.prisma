generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  name         String?
  email        String?              @unique
  emailVerified DateTime?
  image        String?
  /** Null for Google-only accounts (no password set). */
  passwordHash String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  accounts     Account[]
  sessions     Session[]
  projects     Project[]
  definitions  CreatureDefinition[]
  folders      ActorFolder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/** Unused while sessions run as JWTs, kept for adapter-schema compatibility and a future switch to database sessions. */
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  maps        BattleMap[]
  encounters  Encounter[]
}

model BattleMap {
  id             String      @id @default(cuid())
  projectId      String
  name           String
  imagePath      String?
  gridSizePx     Float
  gridOffsetX    Float       @default(0)
  gridOffsetY    Float       @default(0)
  distancePerSq  Float       @default(5)
  widthSquares   Int
  heightSquares  Int
  wallsJson      String
  terrainJson    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  encounters     Encounter[]
}

model CreatureDefinition {
  id             String      @id @default(cuid())
  /** Null = shared read-only template (e.g. SRD/open5e imports); set = a user's own actor. */
  ownerId        String?
  owner          User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /** Id of the template this was cloned from, for provenance. Not an enforced FK — the source may later change or be removed. */
  copiedFromId   String?
  name           String
  sourceKey      String?
  sourceName     String?
  sourceSlug     String?
  importedAt     DateTime?
  importedJson   String?
  schemaVersion  Int         @default(1)
  data           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ActorFolder {
  id        String        @id @default(cuid())
  /** Null would mark a shared/system folder; unused today but kept consistent with CreatureDefinition. */
  ownerId   String?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    ActorFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  ActorFolder[] @relation("FolderChildren")
}

model Encounter {
  id             String          @id @default(cuid())
  projectId      String
  mapId          String?
  name           String
  schemaVersion  Int             @default(1)
  snapshotJson   String
  /** Vercel Blob (CDN) URL for this scene's map background, if one is set. Lives here rather than on BattleMap since each Encounter's own snapshotJson is the real source of truth for its map, not the BattleMap row. */
  mapImageUrl    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  map            BattleMap?      @relation(fields: [mapId], references: [id], onDelete: SetNull)
  simulationRuns SimulationRun[]
}

model SimulationRun {
  id            String    @id @default(cuid())
  encounterId   String
  seed          String
  outcome       String
  rounds        Int
  snapshotJson  String
  metricsJson   String
  eventLogJson  String
  createdAt     DateTime  @default(now())
  encounter     Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
}
