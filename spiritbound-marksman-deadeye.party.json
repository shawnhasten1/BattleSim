    "traits": [
      {
        "id": "spellcasting",
        "name": "Spellcasting",
        "category": "trait",
        "description": "The marksman is a 6th-level spellcaster casting from the artificer list, using Wisdom (spell save DC 15, +7 to hit). It prepares 7 spells and has slots: 4 x 1st, 2 x 2nd.",
        "automationSupport": "full"
      },
      {
        "id": "spiritfire-gun",
        "name": "Spiritfire Gun",
        "category": "trait",
        "description": "A spirit-imbued firearm fired as a ranged spell attack using Wisdom for 1d10 force damage per shot. The marksman fires 2 shots at 6th level (3 at 11th, 4 at 17th) and may split them between targets.",
        "automationSupport": "full"
      },
      {
        "id": "lesser-echo-marks",
        "name": "Lesser Echo Marks",
        "category": "trait",
        "description": "Once per turn, before the attack roll, the marksman channels one Echo Mark into a Spiritfire shot. Known marks: Agonizing Echo (add Wisdom modifier to each shot - modeled as always-on here), Binding Shot (on hit, target's speed -10 ft until your next turn), Grasping Shot (on hit, target makes a Strength save or is pulled 10 ft toward you).",
        "automationSupport": "partial"
      },
      {
        "id": "agonizing-echo",
        "name": "Agonizing Echo",
        "category": "feature",
        "description": "The Agonizing Echo mark adds the marksman's Wisdom modifier to each Spiritfire Gun shot.",
        "automationSupport": "full",
        "effects": [
          {
            "kind": "damage-bonus",
            "actionIds": [
              "spiritfire-shot"
            ],
            "damage": [
              {
                "dice": "0",
                "damageType": "same-as-attack",
                "bonusFormula": {
                  "ability": "wis"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "path-of-the-deadeye",
        "name": "Path of the Deadeye",
        "category": "trait",
        "description": "The Spiritfire Gun takes the form of a tactical Six-Shooter with a normal range of 60 feet and a long range of 120 feet. Precise, controlled fire.",
        "automationSupport": "full"
      },
      {
        "id": "spiritfire-gun-style",
        "name": "Spiritfire Gun Style",
        "category": "trait",
        "description": "The marksman has committed to the Six-Shooter form of the Spiritfire Gun (Path of the Deadeye).",
        "automationSupport": "manual-only"
      },
      {
        "id": "deaths-brand",
        "name": "Death's Brand",
        "category": "feature",
        "description": "Once per turn, when the marksman hits a creature with a Spiritfire shot, it brands the target. With Mark of the Last Breath (6th level) the brand lasts until the end of the marksman's next turn; the next time the branded creature is hit, the brand is consumed and deals an extra 2d6 necrotic damage.",
        "automationSupport": "full",
        "effects": [
          {
            "kind": "apply-condition-on-hit",
            "actionIds": [
              "spiritfire-shot"
            ],
            "target": "target",
            "oncePerTurn": true,
            "appliedCondition": {
              "id": "deaths-brand-active",
              "name": "custom",
              "durationRounds": 1,
              "effects": [
                {
                  "kind": "incoming-hit-damage",
                  "damage": [
                    {
                      "dice": "2d6",
                      "damageType": "necrotic"
                    }
                  ],
                  "critical": false,
                  "consumeCondition": true
                }
              ]
            }
          }
        ]
      },
      {
        "id": "mark-of-the-last-breath",
        "name": "Mark of the Last Breath",
        "category": "trait",
        "description": "6th-level Deadeye feature. Death's Brand now lasts until the end of the marksman's next turn and deals 2d6 necrotic when triggered. Once per long rest, the marksman may brand a second creature in the same turn (resource: deaths-brand-second).",
        "automationSupport": "partial"
      }
