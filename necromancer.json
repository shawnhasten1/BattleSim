    "traits": [
      {
        "id": "grim-harvest",
        "name": "Grim Harvest",
        "category": "trait",
        "description": "Once per turn when a living creature fails a saving throw against or is harmed by one of the necromancer's Necromancy spells of 1st level or higher, the necromancer regains hit points equal to three times the spell's level.",
        "automationSupport": "partial"
      },
      {
        "id": "undead-thralls",
        "name": "Undead Thralls",
        "category": "trait",
        "description": "When the necromancer casts Animate Dead, it can target one additional corpse or pile of bones. Undead created by the necromancer gain 9 additional hit points and +3 damage with weapon attacks.",
        "automationSupport": "partial"
      },
      {
        "id": "frightened-immunity",
        "name": "Frightened Immunity",
        "category": "trait",
        "description": "The necromancer is immune to the frightened condition.",
        "automationSupport": "manual-only"
      },
      {
        "id": "spellcasting",
        "name": "Spellcasting",
        "category": "trait",
        "description": "The necromancer is a 10th-level spellcaster using Intelligence. Spell save DC 15 and +7 to hit with spell attacks.",
        "automationSupport": "full"
      },
      {
        "id": "lair-stitching-hooks",
        "name": "Lair Action: Stitching Hooks",
        "category": "trait",
        "description": "On initiative count 20, one creature within 60 feet must make a DC 15 Dexterity save or take 2d6 piercing damage and become restrained until initiative count 20 of the next round.",
        "automationSupport": "manual-only"
      },
      {
        "id": "lair-surgical-vapors",
        "name": "Lair Action: Surgical Vapors",
        "category": "trait",
        "description": "On initiative count 20, a 15-foot cube within 60 feet fills with vapors. Creatures entering or starting their turn there must make a DC 15 Constitution save or have their speed halved until the start of their next turn.",
        "automationSupport": "manual-only"
      },
      {
        "id": "lair-slab-restraints",
        "name": "Lair Action: Slab Restraints",
        "category": "trait",
        "description": "On initiative count 20, a creature near an operating table must make a DC 15 Dexterity save or become grappled and restrained. While restrained it takes 1d10 necrotic damage at the start of each turn.",
        "automationSupport": "manual-only"
      }
