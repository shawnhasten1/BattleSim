    "features": [
      {
        "id": "spellcasting",
        "name": "Spellcasting",
        "category": "class-feature",
        "description": "The necromancer is a 10th-level spellcaster. Its spellcasting ability is Intelligence (spell save DC 15, +7 to hit with spell attacks). Prepared wizard spells: cantrips (at will) chill touch, mage hand, poison spray, ray of frost; 1st level (4 slots) false life, mage armor, ray of sickness*; 2nd level (3 slots) blindness/deafness*, ray of enfeeblement*; 3rd level (3 slots) animate dead, dispel magic, fear, vampiric touch*; 4th level (3 slots) blight*, ice storm, stoneskin; 5th level (2 slots) cloudkill, cone of cold.",
        "automationSupport": "manual-only"
      },
      {
        "id": "grim-harvest",
        "name": "Grim Harvest",
        "category": "class-feature",
        "description": "Once per turn when a living creature fails a saving throw against, or is harmed by, one of the necromancer's Necromancy spells of 1st level or higher, the necromancer regains hit points equal to three times the spell's level.",
        "automationSupport": "manual-only"
      },
      {
        "id": "undead-thralls",
        "name": "Undead Thralls",
        "category": "class-feature",
        "description": "When the necromancer casts animate dead, it can target one additional corpse or pile of bones, creating another zombie or skeleton. Undead it creates have +9 hit points and a +3 bonus to their weapon damage rolls.",
        "automationSupport": "manual-only"
      },
      {
        "id": "necromancy-spells",
        "name": "Necromancy Spells",
        "category": "class-feature",
        "description": "Spells marked with an asterisk (ray of sickness, ray of enfeeblement, blindness/deafness, vampiric touch, blight) are Necromancy spells of 1st level or higher that require a saving throw or attack roll and therefore trigger Grim Harvest.",
        "automationSupport": "manual-only"
      },
      {
        "id": "frightened-immunity",
        "name": "Condition Immunity: Frightened",
        "category": "trait",
        "description": "The necromancer can't be frightened.",
        "automationSupport": "manual-only"
      },
      {
        "id": "mage-armor",
        "name": "Mage Armor",
        "category": "class-feature",
        "description": "The necromancer increases its Armor Class from 12 to 15 for 8 hours.",
        "automationSupport": "full"
      },
      {
        "id": "stoneskin",
        "name": "Stoneskin",
        "category": "class-feature",
        "description": "For up to 1 hour (concentration), the necromancer has resistance to nonmagical bludgeoning, piercing, and slashing damage.",
        "automationSupport": "full"
      },
      {
        "id": "lair-actions",
        "name": "Lair Actions",
        "category": "trait",
        "description": "On initiative count 20 (losing ties) the necromancer takes one lair action, and can't use the same one two rounds in a row. Stitching Hooks: one creature it can see within 60 ft. makes a DC 15 Dexterity save or takes 7 (2d6) piercing damage and is restrained until initiative 20 next round (escape with an action, DC 15 Str or Dex check). Surgical Vapors: a 15-ft. cube within 60 ft. becomes lightly obscured until initiative 20 next round; a creature that enters or starts its turn there makes a DC 15 Constitution save or has its speed halved until the start of its next turn. Slab Restraints: one creature within 5 ft. of an operating table makes a DC 15 Dexterity save or is grappled and restrained, taking 5 (1d10) necrotic damage at the start of each of its turns (escape with an action, DC 15 Str check).",
        "automationSupport": "manual-only"
      }
    ],
