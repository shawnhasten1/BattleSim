DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth client — create one at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (dev): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod): https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Invite-only gate (Phase 1) — comma-separated emails allowed to create an
# account (Google or password). Checked only at signup, not at login. Unset
# this var later to open signup to everyone.
ALLOWED_SIGNUP_EMAILS=""

# Vercel Blob (Phase 5) — map background images, CDN-served. Create a Blob
# store at https://vercel.com/dashboard -> your project -> Storage -> Create
# Database -> Blob, then copy its read/write token here.
BLOB_READ_WRITE_TOKEN=""
